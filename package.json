{
  "name": "lubi-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @lubi/api",
    "dev:web": "npm run dev -w @lubi/web",
    "build": "npm run build -w @lubi/legacy-domain && npm run build -w @lubi/api && npm run build -w @lubi/web",
    "test": "npm run test -w @lubi/legacy-domain && npm run test:api",
    "test:api": "node --test test/projects.mjs test/restore.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "test:plugin": "node scripts/run-plugin-tests.mjs",
    "test:parity": "node test/parity.mjs",
    "test:browser": "node test/browser.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "setup": "node scripts/setup.mjs",
    "start:api": "npm run start -w @lubi/api",
    "test:security": "node --import tsx --test test/security.mjs",
    "verify": "npm run check:upstream && npm run check:ui-acceptance && npm run test:structure && npm run build && npm test && npm run test:parity && npm run test:security && npm run test:backup && npm run test:launcher && npm run test:plugin && npm run test:host && npm run test:browser && npm run test:ui-review",
    "postinstall": "node scripts/prepare-upstream.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "test:backup": "node --test test/backup.mjs",
    "test:layout": "node test/ui-layout.mjs",
    "test:native": "node test/native.mjs",
    "test:launcher": "node --test test/launcher.mjs",
    "test:structure": "node --test test/structure.mjs",
    "test:host": "node test/host.mjs",
    "test:ui-review": "node test/ui-review.mjs",
    "test:layout:baseline": "node scripts/require-original-ui.mjs && node scripts/run-plugin-tests.mjs layout",
    "preview:review": "node scripts/review-preview.mjs",
    "check:ui-acceptance": "node scripts/check-ui-acceptance.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0"
  }
}
